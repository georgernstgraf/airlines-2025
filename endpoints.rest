### Variables (ersetze diese mit tatsächlichen IDs aus deinen GET-Requests)
@flightId = 1
@passengerId = 1
@planeId = 1
@airportId = 1
@airportId2 = 2

### Health Check
GET http://localhost:3000

### ============ FLIGHTS ============

### Get all flights (basic - ohne Relations)
GET http://localhost:3000/flights

### Get all flights WITH FULL RELATIONS (passengers, plane, origin, destination)
GET http://localhost:3000/flights?include=true

### Get ONE specific flight by ID (mit allen Relations)
GET http://localhost:3000/flights/{{flightId}}

### Update flight by ID
PUT http://localhost:3000/flights/{{flightId}}
Content-Type: application/json

{
  "flightNumber": "OS456",
  "departureTime": "2025-12-02T14:00:00Z",
  "arrivalTime": "2025-12-02T16:00:00Z",
  "originId": "{{airportId}}",
  "destinationId": "{{airportId2}}",
  "planeId": "{{planeId}}"
}

### Delete flight by ID
DELETE http://localhost:3000/flights/{{flightId}}

### ============ PASSENGERS ============

### Get all passengers
GET http://localhost:3000/passengers

### Get passenger by ID
GET http://localhost:3000/passengers/{{passengerId}}

### Create new passenger
POST http://localhost:3000/passengers
Content-Type: application/json

{
  "firstName": "Max",
  "lastName": "Mustermann",
  "email": "max.mustermann@example.com"
}

### Update passenger by ID
PUT http://localhost:3000/passengers/{{passengerId}}
Content-Type: application/json

{
  "firstName": "Maximilian",
  "lastName": "Mustermann",
  "email": "maximilian.mustermann@example.com"
}

### Delete passenger by ID
DELETE http://localhost:3000/passengers/{{passengerId}}

